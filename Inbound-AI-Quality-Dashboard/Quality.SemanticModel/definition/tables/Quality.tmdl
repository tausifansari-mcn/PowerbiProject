		lineageTag: 08931869-482d-466d-bc1c-292c05ab393b

	measure 'Good Audits' = CALCULATE(COUNTROWS(Quality), Quality[Is Audited]=TRUE(), Quality[quality_percentage] >= 90, Quality[quality_percentage] < 98)
