		displayFolder: 1 Core KPIs
		lineageTag: b5b50ebd-c55d-45a1-b5da-e146e5970294

	measure 'Excellent Audits' = CALCULATE(COUNTROWS(Quality), Quality[Is Audited]=TRUE(), Quality[quality_percentage] >= 98)
