	column 'CQ Ratio' = IF(Quality[ClientId]="468", VAR n = IF(NOT ISBLANK(Quality[call_answered_within_5_seconds]),1,0)+IF(NOT ISBLANK(Quality[professionalism_maintained]),1,0)+IF(NOT ISBLANK(Quality[assurance_or_appreciation_provided]),1,0)+IF(NOT ISBLANK(Quality[pronunciation_and_clarity]),1,0)+IF(NOT ISBLANK(Quality[enthusiasm_and_no_fumbling]),1,0)+IF(NOT ISBLANK(Quality[active_listening]),1,0)+IF(NOT ISBLANK(Quality[politeness_and_no_sarcasm]),1,0)+IF(NOT ISBLANK(Quality[proper_grammar]),1,0)+IF(NOT ISBLANK(Quality[accurate_issue_probing]),1,0)+IF(NOT ISBLANK(Quality[customer_concern_acknowledged]),1,0)+IF(NOT ISBLANK(Quality[proper_hold_procedure]),1,0)+IF(NOT ISBLANK(Quality[proper_transfer_and_language]),1,0)+IF(NOT ISBLANK(Quality[dead_air_under_10_seconds]),1,0)+IF(NOT ISBLANK(Quality[case_escalated_correctly]),1,0)+IF(NOT ISBLANK(Quality[address_recorded_completely]),1,0)+IF(NOT ISBLANK(Quality[correct_and_complete_information]),1,0)+IF(NOT ISBLANK(Quality[upselling_or_offers_suggested]),1,0)+IF(NOT ISBLANK(Quality[further_assistance_offered]),1,0)+IF(NOT ISBLANK(Quality[proper_call_closure]),1,0)+IF(NOT ISBLANK(Quality[express_empathy]),1,0) VAR p = IF(Quality[call_answered_within_5_seconds]=TRUE(),1,0)+IF(Quality[professionalism_maintained]=TRUE(),1,0)+IF(Quality[assurance_or_appreciation_provided]=TRUE(),1,0)+IF(Quality[pronunciation_and_clarity]=TRUE(),1,0)+IF(Quality[enthusiasm_and_no_fumbling]=TRUE(),1,0)+IF(Quality[active_listening]=TRUE(),1,0)+IF(Quality[politeness_and_no_sarcasm]=TRUE(),1,0)+IF(Quality[proper_grammar]=TRUE(),1,0)+IF(Quality[accurate_issue_probing]=TRUE(),1,0)+IF(Quality[customer_concern_acknowledged]=TRUE(),1,0)+IF(Quality[proper_hold_procedure]=TRUE(),1,0)+IF(Quality[proper_transfer_and_language]=TRUE(),1,0)+IF(Quality[dead_air_under_10_seconds]=TRUE(),1,0)+IF(Quality[case_escalated_correctly]=TRUE(),1,0)+IF(Quality[address_recorded_completely]=TRUE(),1,0)+IF(Quality[correct_and_complete_information]=TRUE(),1,0)+IF(Quality[upselling_or_offers_suggested]=TRUE(),1,0)+IF(Quality[further_assistance_offered]=TRUE(),1,0)+IF(Quality[proper_call_closure]=TRUE(),1,0)+IF(Quality[express_empathy]=TRUE(),1,0) RETURN IF(n=0, BLANK(), DIVIDE(p,n)), VAR n = IF(NOT ISBLANK(Quality[call_answered_within_5_seconds]),1,0)+IF(NOT ISBLANK(Quality[professionalism_maintained]),1,0)+IF(NOT ISBLANK(Quality[assurance_or_appreciation_provided]),1,0)+IF(NOT ISBLANK(Quality[pronunciation_and_clarity]),1,0)+IF(NOT ISBLANK(Quality[enthusiasm_and_no_fumbling]),1,0)+IF(NOT ISBLANK(Quality[active_listening]),1,0)+IF(NOT ISBLANK(Quality[politeness_and_no_sarcasm]),1,0)+IF(NOT ISBLANK(Quality[proper_grammar]),1,0)+IF(NOT ISBLANK(Quality[accurate_issue_probing]),1,0)+IF(NOT ISBLANK(Quality[customer_concern_acknowledged]),1,0)+IF(NOT ISBLANK(Quality[proper_hold_procedure]),1,0)+IF(NOT ISBLANK(Quality[proper_transfer_and_language]),1,0)+IF(NOT ISBLANK(Quality[dead_air_under_10_seconds]),1,0)+IF(NOT ISBLANK(Quality[case_escalated_correctly]),1,0)+IF(NOT ISBLANK(Quality[address_recorded_completely]),1,0)+IF(NOT ISBLANK(Quality[correct_and_complete_information]),1,0)+IF(NOT ISBLANK(Quality[upselling_or_offers_suggested]),1,0)+IF(NOT ISBLANK(Quality[further_assistance_offered]),1,0)+IF(NOT ISBLANK(Quality[proper_call_closure]),1,0) VAR p = IF(Quality[call_answered_within_5_seconds]=TRUE(),1,0)+IF(Quality[professionalism_maintained]=TRUE(),1,0)+IF(Quality[assurance_or_appreciation_provided]=TRUE(),1,0)+IF(Quality[pronunciation_and_clarity]=TRUE(),1,0)+IF(Quality[enthusiasm_and_no_fumbling]=TRUE(),1,0)+IF(Quality[active_listening]=TRUE(),1,0)+IF(Quality[politeness_and_no_sarcasm]=TRUE(),1,0)+IF(Quality[proper_grammar]=TRUE(),1,0)+IF(Quality[accurate_issue_probing]=TRUE(),1,0)+IF(Quality[customer_concern_acknowledged]=TRUE(),1,0)+IF(Quality[proper_hold_procedure]=TRUE(),1,0)+IF(Quality[proper_transfer_and_language]=TRUE(),1,0)+IF(Quality[dead_air_under_10_seconds]=TRUE(),1,0)+IF(Quality[case_escalated_correctly]=TRUE(),1,0)+IF(Quality[address_recorded_completely]=TRUE(),1,0)+IF(Quality[correct_and_complete_information]=TRUE(),1,0)+IF(Quality[upselling_or_offers_suggested]=TRUE(),1,0)+IF(Quality[further_assistance_offered]=TRUE(),1,0)+IF(Quality[proper_call_closure]=TRUE(),1,0) RETURN IF(n=0, BLANK(), DIVIDE(p,n)))
