		lineageTag: ef7ea69e-934c-4336-9382-8735b31898d0

	measure 'Agent Grade' = SWITCH(TRUE(), ISBLANK([CQ Score %]), BLANK(), [CQ Score %] >= 90, "TQ", [CQ Score %] >= 80, "MQ", "BQ")
