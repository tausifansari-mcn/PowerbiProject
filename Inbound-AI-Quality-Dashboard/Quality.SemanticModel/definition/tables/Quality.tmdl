	column 'Soft Ratio' = IF(Quality[scenario1] IN {"Call Drop in between","Short Call/Blank Call"}, 1, VAR n = IF(NOT ISBLANK(Quality[professionalism_maintained]),1,0)+IF(NOT ISBLANK(Quality[assurance_or_appreciation_provided]),1,0)+IF(NOT ISBLANK(Quality[pronunciation_and_clarity]),1,0)+IF(NOT ISBLANK(Quality[enthusiasm_and_no_fumbling]),1,0)+IF(NOT ISBLANK(Quality[active_listening]),1,0)+IF(NOT ISBLANK(Quality[politeness_and_no_sarcasm]),1,0)+IF(NOT ISBLANK(Quality[proper_grammar]),1,0)+IF(NOT ISBLANK(Quality[accurate_issue_probing]),1,0)+IF(NOT ISBLANK(Quality[customer_concern_acknowledged]),1,0) VAR p = IF(Quality[professionalism_maintained]=TRUE(),1,0)+IF(Quality[assurance_or_appreciation_provided]=TRUE(),1,0)+IF(Quality[pronunciation_and_clarity]=TRUE(),1,0)+IF(Quality[enthusiasm_and_no_fumbling]=TRUE(),1,0)+IF(Quality[active_listening]=TRUE(),1,0)+IF(Quality[politeness_and_no_sarcasm]=TRUE(),1,0)+IF(Quality[proper_grammar]=TRUE(),1,0)+IF(Quality[accurate_issue_probing]=TRUE(),1,0)+IF(Quality[customer_concern_acknowledged]=TRUE(),1,0) RETURN IF(n=0, BLANK(), DIVIDE(p,n)))
