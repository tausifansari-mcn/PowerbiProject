	column 'Hold Ratio' = IF(Quality[scenario1] IN {"Call Drop in between","Short Call/Blank Call"}, 1, VAR n = IF(NOT ISBLANK(Quality[proper_hold_procedure]),1,0)+IF(NOT ISBLANK(Quality[proper_transfer_and_language]),1,0)+IF(NOT ISBLANK(Quality[dead_air_under_10_seconds]),1,0) VAR p = IF(Quality[proper_hold_procedure]=TRUE(),1,0)+IF(Quality[proper_transfer_and_language]=TRUE(),1,0)+IF(Quality[dead_air_under_10_seconds]=TRUE(),1,0) RETURN IF(n=0, BLANK(), DIVIDE(p,n)))
