	column 'Fatal Flag' = IF((NOT ISBLANK(Quality[case_escalated_correctly]) && Quality[case_escalated_correctly]=FALSE()) && (NOT ISBLANK(Quality[address_recorded_completely]) && Quality[address_recorded_completely]=FALSE()) && (NOT ISBLANK(Quality[correct_and_complete_information]) && Quality[correct_and_complete_information]=FALSE()), 1, 0)
		dataType: int64
		formatString: 0
