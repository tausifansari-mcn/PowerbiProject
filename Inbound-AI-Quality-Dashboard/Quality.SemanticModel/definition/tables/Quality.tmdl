		displayFolder: 1 Core KPIs
		lineageTag: 7b6e2571-7d3b-4fd2-9a85-b679b37c6797

	measure 'CQ Score incl. Fatal %' = ROUND(CALCULATE(AVERAGE(Quality[CQ Ratio]), Quality[Is Audited]=TRUE())*100, 1)
