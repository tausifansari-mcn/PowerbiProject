	measure 'Below Average Audits' = CALCULATE(COUNTROWS(Quality), Quality[Is Audited]=TRUE(), Quality[quality_percentage] > 0, Quality[quality_percentage] < 85)
		formatString: #,0
		displayFolder: 2 Quality Bands
		lineageTag: 7e2307dd-fcf0-4e42-a668-cb124a464403

	measure 'Excellent %' = DIVIDE([Excellent Audits], [Total Audits])
		formatString: 0.0%
		displayFolder: 2 Quality Bands
		lineageTag: 987994eb-131c-410a-b6a2-d2d40de10453

	measure 'Good %' = DIVIDE([Good Audits], [Total Audits])
		formatString: 0.0%
		displayFolder: 2 Quality Bands
		lineageTag: 4501d68f-f700-4c98-89a5-ce64e64b3385

	measure 'Average %' = DIVIDE([Average Audits], [Total Audits])
