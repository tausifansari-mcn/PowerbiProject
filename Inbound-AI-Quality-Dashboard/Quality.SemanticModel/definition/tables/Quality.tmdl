table Quality
	lineageTag: 02cf80d7-bd19-4107-86c5-61e541402299

	measure 'Total Audits' = CALCULATE(COUNTROWS(Quality), Quality[Is Audited]=TRUE())
		formatString: #,0
		displayFolder: 1 Core KPIs
		lineageTag: f6089f25-ac90-4fac-ba44-15af56012b02

	measure 'CQ Score %' = ROUND(CALCULATE(AVERAGE(Quality[CQ Ratio]), Quality[Is Audited]=TRUE(), Quality[NonFatal Flag]=1)*100, 1)
