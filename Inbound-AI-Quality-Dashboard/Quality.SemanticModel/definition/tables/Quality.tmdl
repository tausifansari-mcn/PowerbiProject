		lineageTag: 443b2973-76df-4fa6-87ad-a3f817f25a61
		summarizeBy: none

	column 'Resolution Ratio' = IF(Quality[scenario1] IN {"Call Drop in between","Short Call/Blank Call"}, 1, VAR n = IF(NOT ISBLANK(Quality[case_escalated_correctly]),1,0)+IF(NOT ISBLANK(Quality[address_recorded_completely]),1,0)+IF(NOT ISBLANK(Quality[correct_and_complete_information]),1,0)+IF(NOT ISBLANK(Quality[upselling_or_offers_suggested]),1,0) VAR p = IF(Quality[case_escalated_correctly]=TRUE(),1,0)+IF(Quality[address_recorded_completely]=TRUE(),1,0)+IF(Quality[correct_and_complete_information]=TRUE(),1,0)+IF(Quality[upselling_or_offers_suggested]=TRUE(),1,0) RETURN IF(n=0, BLANK(), DIVIDE(p,n)))
		dataType: double
		formatString: 0.0%
		lineageTag: 2f8f49f7-5404-4252-a79c-81f240e34d69
		summarizeBy: none

	column 'Closing Ratio' = IF(Quality[scenario1] IN {"Call Drop in between","Short Call/Blank Call"}, 1, VAR n = IF(NOT ISBLANK(Quality[further_assistance_offered]),1,0)+IF(NOT ISBLANK(Quality[proper_call_closure]),1,0) VAR p = IF(Quality[further_assistance_offered]=TRUE(),1,0)+IF(Quality[proper_call_closure]=TRUE(),1,0) RETURN IF(n=0, BLANK(), DIVIDE(p,n)))
		dataType: double
		formatString: 0.0%
		lineageTag: 0a5f2295-57fe-4da1-b417-cfea4f29bcf0
		summarizeBy: none

	column 'Quality Band' = SWITCH(TRUE(), Quality[quality_percentage] >= 98, "1 Excellent", Quality[quality_percentage] >= 90, "2 Good", Quality[quality_percentage] >= 85, "3 Average", Quality[quality_percentage] > 0, "4 Below Average", "5 Zero score")
		dataType: string
		lineageTag: c1c5fa7c-5a29-40d4-ac7a-69ec2975d3cb
		summarizeBy: none

	column 'Call Category' = IF(Quality[Fatal Flag]=1, "Fatal", "Non-fatal")
		dataType: string
		lineageTag: ee8a0e33-b10e-491f-8a5d-fe34b9cbf9b4
		summarizeBy: none

	column 'Duration Bucket' = VAR s = VALUE(Quality[length_in_sec]) RETURN IF(ISBLANK(s), BLANK(), SWITCH(TRUE(), s < 60, "1 Short (<1 min)", s < 301, "2 Average (1-5 min)", s < 600, "3 Long (5-10 min)", "4 Extremely long (>10 min)"))
		dataType: string
		lineageTag: 51127f9e-390f-4069-ac81-c3c5bf0ea5a6
		summarizeBy: none

	column 'Duration Sec' = IFERROR(VALUE(Quality[length_in_sec]), BLANK())
		dataType: double
		formatString: 0
		lineageTag: d6da7c62-1623-45fb-97ec-32a63143f785
		summarizeBy: none

	column Week = SWITCH(TRUE(), DAY(Quality[CallDate]) <= 7, "Week 1", DAY(Quality[CallDate]) <= 14, "Week 2", DAY(Quality[CallDate]) <= 21, "Week 3", "Week 4")
		dataType: string
		lineageTag: 06be4260-6b76-4878-ac48-4ad1a73a5d9f
		summarizeBy: none

	column 'Abuse Flag' = IF(COALESCE(Quality[agent_english_cuss_count], 0) + COALESCE(Quality[agent_hindi_cuss_count], 0) + COALESCE(Quality[customer_english_cuss_count], 0) + COALESCE(Quality[customer_hindi_cuss_count], 0) > 0, 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: 502684d2-b258-46a9-adf6-066d2210d80f
		summarizeBy: none

	column 'Scam Flag' = VAR n = LOWER(COALESCE(Quality[top_negative_words], "")) RETURN IF(LOWER(TRIM(COALESCE(Quality[financial_fraud], ""))) = "yes" || SEARCH("scam", n, 1, 0) > 0 || SEARCH("fraud", n, 1, 0) > 0 || SEARCH("cheat", n, 1, 0) > 0 || SEARCH("fake", n, 1, 0) > 0 || SEARCH("loot", n, 1, 0) > 0, 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: 5ea82d75-add9-4380-bb8f-489fca23c635
		summarizeBy: none

	column 'Social Court Flag' = VAR s = LOWER(COALESCE(Quality[sensetive_word], "")) RETURN IF(Quality[Scam Flag] = 0 && (SEARCH("social", s, 1, 0) > 0 || SEARCH("court", s, 1, 0) > 0 || SEARCH("consumer", s, 1, 0) > 0 || SEARCH("legal", s, 1, 0) > 0 || SEARCH("fir", s, 1, 0) > 0), 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: 1e8c000b-40f0-4e5f-856a-b295e65bd520
		summarizeBy: none

